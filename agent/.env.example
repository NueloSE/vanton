# Vanton demo agent config. Copy to .env (gitignored) and fill.

# Canton devnet login (same as your wallet) — used to fetch ledger tokens
CANTON_USERNAME=
CANTON_PASSWORD=

# Where the Vanton gateway runs
GATEWAY_URL=http://localhost:3402

# Loop behavior
INTERVAL_MS=15000
MAX_CALLS=10

# On-ledger mandate (set once the DAR is deployed on the shared node)
MANDATE_CID=
LEDGER_API_URL=https://ledger-api-json.participant.hackcanton-01.devnet.naas.noders.services:443

# AI agent
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
BUDGET_CC=0.05
