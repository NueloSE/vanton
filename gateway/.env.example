# --- Vanton gateway config ---
PORT=3402

# Operator key protecting the state-changing endpoints (POST /listings, /set-budget,
# /run-agent — the last moves real funds). Requests must send `x-admin-key: <this>`.
# Set it in production; if unset, those endpoints run OPEN (dev only). The hosted UI
# prompts the operator for this key on the first privileged action and remembers it.
ADMIN_KEY=

# x402 facilitator (FTP hosted works for CC today; self-host for cBTC/cETH later)
FACILITATOR_URL=https://facilitator.ftptech.xyz
NETWORK=canton:mainnet

# Price per call, atomic units on the x402 "exact" wire. 1 CC = 10^10. 0.01 CC:
X402_AMOUNT=100000000

# Canton parties / ids (fill from your devnet wallet + Scan)
CANTON_X402_PAYTO=          # merchant/provider party (this gateway's payee)
CANTON_X402_FACILITATOR=    # facilitator party id
CANTON_X402_DSO=            # DSO party (Amulet admin) — asset = <DSO>::Amulet
CANTON_SYNCHRONIZER_ID=     # global synchronizer id
EXECUTE_BEFORE_SECONDS=120

# --- Canton devnet login (Keycloak password grant; auto-fetches the token) ---
# These stay local — .env is gitignored. Same email + password as your devnet wallet.
CANTON_USERNAME=            # your devnet wallet email
CANTON_PASSWORD=            # your devnet wallet password

# --- On-ledger mandate (live spend enforcement) ---
# The DAR is deployed on the shared hackcanton devnet node; create the mandate and
# print these values with:  node scripts/setup-devnet-mandate.mjs
# (For a purely local run instead: daml sandbox ... + scripts/setup-local-mandate.mjs,
#  then set MANDATE_AUTH=false and LOCAL_LEDGER_API_URL=http://localhost:7575.)
VANTON_PACKAGE_ID=          # vanton DAR package id (enables the mandate gate)
LOCAL_LEDGER_API_URL=       # JSON Ledger API hosting the mandate (shared devnet or local)
MANDATE_AUTH=true           # true for the shared devnet node (needs the OIDC token); false for local sandbox
# Atomic settlement: when true, the gateway refuses over-budget at the 402 (read-only),
# then after payment settles exercises Mandate_Charge — one ledger tx that decrements the
# budget AND mints a Receipt bound to the settlement ref. false = legacy Mandate_Authorize
# (decrements at challenge time, no receipt). Needs the v0.2.0+ DAR (has Mandate_Charge).
MANDATE_CHARGE=true
VANTON_OPERATOR_PARTY=      # vanton-operator party
VANTON_AGENT_PARTY=         # vanton-agent party whose mandate is enforced
